rules_version = '2';

// كل مستخدم يقرأ ويكتب داخل users/{uid}/... الخاصة به فقط. أي شيء آخر مرفوض.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid}/{document=**} {
      allow read, write: if request.auth != null && request.auth.uid == uid;

      // اختياري — حصر الدخول على بريدك أنت فقط (فك التعليق وضع بريدك):
      // allow read, write: if request.auth != null
      //                    && request.auth.uid == uid
      //                    && request.auth.token.email == 'YOUR_EMAIL@gmail.com'
      //                    && request.auth.token.email_verified == true;
    }

    // ---------------------------------------------------------------------------
    // مشاركة المشاريع (المرحلة 1: قراءة فقط للمستخدمين)
    //
    // بيانات المدير الأصلية في users/{uid}/... لا تُفتح لأحد. برنامج المدير يكتب «نسخة مشتركة» هنا،
    // كل قسم في مستند مستقل فيه قائمة البريد المسموح لها بقراءته (readers).
    // معرّف المشاركة = {uid المدير}_{معرّف المشروع}، ومنه نعرف المالك دون الاعتماد على حقل يمكن تزويره.
    // ---------------------------------------------------------------------------
    function ownsShare(shareId) {
      return request.auth != null && shareId.matches(request.auth.uid + '_.+');
    }
    function isVerifiedUser() {
      return request.auth != null
        && request.auth.token.email != null
        && request.auth.token.email_verified == true;
    }

    match /shares/{shareId} {
      // مستند التعريف: اسم المشروع وقائمة كل من له أي صلاحية (يقرؤه الضيوف المسجلون فقط، والمالك).
      allow read: if ownsShare(shareId)
        || (isVerifiedUser() && request.auth.token.email.lower() in resource.data.members);
      allow write: if ownsShare(shareId);

      match /sections/{section} {
        allow read: if ownsShare(shareId)
          || (isVerifiedUser() && request.auth.token.email.lower() in resource.data.readers);
        allow write: if ownsShare(shareId);
      }

      // طلبات تعديل الضيوف (المرحلة 2). الضيف يستطيع «إنشاء» طلب جديد فقط، ولا يعدّل ولا يحذف أي شيء،
      // ولا يلمس بياناتك الأصلية. المالك وحده يقرأ كل الطلبات ويغيّر حالتها (موافقة/رفض) ويحذفها.
      match /requests/{requestId} {
        function validRequest() {
          let d = request.resource.data;
          let email = request.auth.token.email.lower();
          return isVerifiedUser()
            && d.keys().hasOnly(['type', 'targetId', 'payload', 'authorEmail', 'authorName', 'status', 'createdAt'])
            && d.keys().hasAll(['type', 'targetId', 'payload', 'authorEmail', 'authorName', 'status', 'createdAt'])
            && d.status == 'pending'
            && d.authorEmail == email
            && d.authorName == request.auth.token.get('name', '')
            && d.createdAt is int
            && d.targetId is string && d.targetId.size() <= 120
            && d.payload is map
            && d.payload.keys().hasOnly(['status', 'text'])
            && (!('status' in d.payload) || d.payload.status in ['approved', 'revision'])
            && (!('text' in d.payload) || (d.payload.text is string && d.payload.text.size() <= 2000))
            && (
              (d.type == 'deliverable_status' && editsSection(shareId, 'deliverables', email))
              || (d.type == 'requirement_add' && editsSection(shareId, 'technical', email))
              || (d.type == 'meeting_note' && editsSection(shareId, 'meetings', email))
              || (d.type == 'installment_paid' && editsSection(shareId, 'finance', email))
            );
        }
        function editsSection(sid, sectionName, email) {
          return email in get(/databases/$(database)/documents/shares/$(sid)/sections/$(sectionName)).data.editors;
        }

        allow read: if ownsShare(shareId)
          || (isVerifiedUser() && resource.data.authorEmail == request.auth.token.email.lower());
        allow create: if validRequest();
        allow update, delete: if ownsShare(shareId);
      }
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
